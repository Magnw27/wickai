# Server-only AI configuration. Never expose these with NEXT_PUBLIC_.
# OpenRouter:
WICKAI_BASE_URL=https://openrouter.ai/api/v1
# Local 9router example:
# WICKAI_BASE_URL=http://127.0.0.1:8000/v1
WICKAI_API_KEY=
WICKAI_MODEL=wick-ultra2.3

# WickAI model catalog shown in the UI.
# Format: model-id|Display Name,model-id|Display Name
WICKAI_MODELS=wick-fast|Wick Fast,wick-1.5|Wick 1.5,wick-ultra2.3|Wick Ultra 2.3,wick-chat|Wick Chat

# Optional public app metadata for links/headers later.
WICKAI_APP_URL=http://localhost:3000
